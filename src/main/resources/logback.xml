        <!-- 2) File appender for system output -->
        <appender name="SYSOUT" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/app/logs/output.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <!-- Again, point to the absolute path -->
                <fileNamePattern>/app/logs/output.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
                <maxHistory>7</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{ISO8601},%logger{0},%msg%n</pattern>
            </encoder>
        </appender>

        <!-- 3) Console (still logs to stdout, if you need it) -->
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <!-- Metric logger -->
        <logger name="com.holon.metrics" level="INFO" additivity="false">
            <appender-ref ref="METRICS"/>
        </logger>

        <!-- System output logger -->
        <logger name="com.holon.system.output" level="INFO" additivity="false">
            <appender-ref ref="SYSOUT"/>
        </logger>

        <!-- Root goes to console -->
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
        </root>

    </configuration>