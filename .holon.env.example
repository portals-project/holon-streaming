# Local config for run-experiment.sh — copy to `.holon.env` and fill in.
# `.holon.env` is gitignored.

# EC2 instance to start/stop for each experiment run.
INSTANCE_ID=i-0abc123def456

# AWS region the instance lives in.
AWS_REGION=eu-central-1

# Absolute (or Git-Bash style) path to the SSH private key.
KEY=/c/Users/you/path/to/key.pem

# SSH login user on the EC2 instance.
REMOTE_USER=ec2-user

# Remote working directory (will be wiped on each run).
REMOTE_BASE=~/holon/flink-experiments

# Local directory where each run's results are stored.
LOCAL_RESULTS_DIR=./experiment-results

# --- EBS volume performance toggle (scripts/aws/ebs-perf.sh) ---------------
# The gp3 volume whose IOPS/throughput you ramp up/down per benchmarking day.
VOLUME_ID=vol-0abc123def456

# Performance knobs (optional — these are the defaults).
# "up"/"on"  -> HIGH_IOPS / HIGH_THROUGHPUT (benchmark)
# "down"/"off" -> LOW_IOPS / LOW_THROUGHPUT (baseline, free tier)
HIGH_IOPS=12000
HIGH_THROUGHPUT=750
LOW_IOPS=3000
LOW_THROUGHPUT=125
