# HOLON experiment template — SBT "on-the-fly" flow.
# Same Q7 workload as holon-q7-baseline, but DEPLOYMENT=nexmark-remote routes the
# runner through the source-synced, compile-on-the-box deployment so you can edit
# Scala locally and re-run on AWS without reassembling the fat JAR.
NAME="Holon Q7 (SBT on-the-fly)"
DESCRIPTION="Holon Nexmark Q7, source compiled on the box, 10 nodes, HTTP start gate"

PLATFORM=holon
DEPLOYMENT=nexmark-remote
INCREASE_VOLUME=true

QUERY=q7
WORKLOAD=7

EVENTS_PER_SECOND=10000
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=400000

ENABLE_RATE_LIMIT=false
PROCESSING_RATE_LIMIT=10000

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
