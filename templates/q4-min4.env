# HOLON experiment template
NAME="Q4 Min4 (bisection: + outer aggregation = full q4 minus SET hints)"
DESCRIPTION="Stage 2c: structurally identical to q4_optimized (nested aggregation cascade, upsert-kafka PK on category) but WITHOUT the 3 SET hints (mini-batch / two-phase / state-ttl)."

PLATFORM=flink
DEPLOYMENT=flink-remote-java
INCREASE_VOLUME=true

QUERY=q4_min4
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
