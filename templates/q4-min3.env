# HOLON experiment template
NAME="Q4 Min3 (bisection: + interval JOIN)"
DESCRIPTION="Stage 2b: q4_optimized's inner subquery written directly to the sink — interval JOIN + GROUP BY (auction_id, category) → upsert-kafka. No outer aggregation, no SET hints."

PLATFORM=flink
DEPLOYMENT=flink-remote-java
INCREASE_VOLUME=true

QUERY=q4_min3
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=400000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
