# HOLON experiment template
NAME="Q4 Min2 (bisection: + bid table, no JOIN)"
DESCRIPTION="Stage 2a: same as q4_min, but with the bid source table declared (unused in INSERT). Tests whether two CREATE TABLEs on the same Kafka topic break submission."

PLATFORM=flink
DEPLOYMENT=flink-remote-java
INCREASE_VOLUME=true

QUERY=q4_min2
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=400000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
