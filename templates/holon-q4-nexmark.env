# HOLON experiment template
NAME="Holon Q4 Nexmark"
DESCRIPTION="Holon Nexmark Q4 interval join, 50 nodes, high throughput"

PLATFORM=holon
DEPLOYMENT=nexmark-remote-java
INCREASE_VOLUME=true

QUERY=q4
WORKLOAD=4

EVENTS_PER_SECOND=10000
N_NODES=10
PARTITIONS_PER_NODE=5
PRODUCER_COUNT=10
PRODUCER_SLEEP_MS=50
PRODUCER_BATCH_SIZE=512

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=false
PROCESSING_RATE_LIMIT=10000

GARBAGE_COLLECTION_OFFSET=3
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
