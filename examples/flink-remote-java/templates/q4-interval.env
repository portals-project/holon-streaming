# HOLON experiment template
NAME="Q4 Interval (single-job interval join, constant bound, full Q4)"
DESCRIPTION="Performant single-job Q4: nested aggregation cascade fed by a TRUE interval join (constant 60s bound on start_ts) so Flink uses the bounded interval-join operator instead of an unbounded regular join. No intermediate Kafka stage, no SET hints. Tune the INTERVAL in q4_interval.sql to >= the max auction lifetime."

QUERY=q4_interval
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
