# HOLON experiment template
NAME="Q4 split S3 (join only, no aggregation)"
DESCRIPTION="Diagnostic stage 3 of the q4_nexmark split: single source + auction/bid views + the time-bounded JOIN, no aggregation. One [OUTPUT] per matched (auction,bid) pair. Many=join works (breaker is downstream agg); ~1=join under-matches; 0/exception=time-attribute-through-view problem."

QUERY=q4_nx_join
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
