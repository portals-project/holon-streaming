# HOLON experiment template
NAME="Q4 Optimized"
DESCRIPTION="Nexmark Q4 single-job optimized (mini-batch + two-phase agg), 500 events/sec"

QUERY=q4_optimized
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=400000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
