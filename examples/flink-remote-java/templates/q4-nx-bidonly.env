# HOLON experiment template
NAME="Q4 split S1 (bid view passthrough)"
DESCRIPTION="Diagnostic stage 1 of the q4_nexmark split: single source + bid view -> output, one record per bid. Confirms source/view/sink/\$type-filter emit. Expect many [OUTPUT]."

QUERY=q4_nx_bidonly
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
