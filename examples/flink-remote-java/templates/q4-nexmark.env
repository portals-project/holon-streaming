# HOLON experiment template
NAME="Q4 Nexmark (official structure: single source + auction/bid views, official q4)"
DESCRIPTION="Path B: mirrors the official nexmark-flink Q4 setup on Kafka - ONE source table over the input topic with ONE computed rowtime and ONE watermark, auction/bid as VIEWS filtered by event.\$type, and the official q4 join/aggregation on top. Sink adapted to the consumer's OutputRecordQ4 shape. Goal: fix the two-source/two-watermark deviation that stalled the time-bounded join."

QUERY=q4_nexmark
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
