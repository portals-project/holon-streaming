# HOLON experiment template
NAME="Q4 Join Test (inner join + per-auction MAX, no *1000, isolates join matching)"
DESCRIPTION="Diagnostic: q4_stage_1's inner join + per-auction MAX only (no outer GROUP BY), sunk to output in Q4 shape, with the *1000 timestamp scaling removed and schema fixes applied. If [OUTPUT] lines appear, the join matches at ms scale and the breaker is the chained outer aggregation; if not, removing *1000 broke join matching."

QUERY=q4_join_test
WORKLOAD=4
PARALLELISM=10

EVENTS_PER_SECOND=500
N_NODES=10
PARTITIONS_PER_NODE=2
PRODUCER_COUNT=20
PRODUCER_SLEEP_MS=100
PRODUCER_BATCH_SIZE=1024

WINDOW_LENGTH=10000
RUNTIME=300000

ENABLE_RATE_LIMIT=true
PROCESSING_RATE_LIMIT=500

GARBAGE_COLLECTION_OFFSET=10
FLUSH_THRESHOLD=500
TOPIC_METRICS_INTERVAL=5000
